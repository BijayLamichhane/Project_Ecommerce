# Database (MongoDB) Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/renthub_db
MONGO_PORT=27017

# Postgres / Adminer Configuration
POSTGRES_USER=renthub
POSTGRES_PASSWORD=renthub_secret
POSTGRES_DB=renthub_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://renthub:renthub_secret@localhost:5432/renthub_db

# Redis Configuration
REDIS_ENABLED=false
REDIS_PASSWORD=renthub_redis_secret
REDIS_PORT=6379
REDIS_URL=redis://:renthub_redis_secret@localhost:6379

# Better Auth Configuration
BETTER_AUTH_SECRET=change_me_to_a_long_random_string_at_least_32_chars
BETTER_AUTH_URL=http://localhost:5000

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
SMTP_FROM="RentHub <noreply@renthub.app>"

# Payment / eSewa
PAYMENT_SECRET=change_me_payment_secret
PAYMENT_WEBHOOK_SECRET=change_me_webhook_secret
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_CHECKOUT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# Payment / Debit & Credit Card
# Keep disabled until your card-acquiring gateway (for example Nabil EPG)
# provides its merchant credentials and integration specification.
CARD_GATEWAY_ENABLED=false
CARD_GATEWAY_CHECKOUT_URL=
CARD_GATEWAY_MERCHANT_ID=
CARD_GATEWAY_SECRET=

# Adminer (optional)
ADMINER_PORT=8080

# Booking Payment Holds 
PENDING_BOOKING_TTL_MINUTES=20

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
