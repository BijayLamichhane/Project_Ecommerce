# ─── Database (MongoDB) ─────────────────────────────────────────
# This is the database the server actually connects to (see
# server/src/config/database.js and config/auth.js).
MONGODB_URI=mongodb://127.0.0.1:27017/renthub_db
MONGO_PORT=27017

# ─── Postgres / Adminer ─────────────────────────────────────────
# NOTE: nothing in server/src currently connects to Postgres — the app and
# Better Auth both use MONGODB_URI above. These are kept here only because
# docker-compose.yml still provisions Postgres + Adminer containers; remove
# both sections together if you don't need them, or wire up MONGODB_URI to
# a "mongo" service in docker-compose.yml instead (see its comments).
POSTGRES_USER=renthub
POSTGRES_PASSWORD=renthub_secret
POSTGRES_DB=renthub_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://renthub:renthub_secret@localhost:5432/renthub_db

# ─── Redis (optional — off by default) ────────────────────────────
# The app runs fully without Redis: it's only used to cache category/product
# reads and to add an extra distributed lock on booking creation, on top of
# the database-level checks that run either way. Set REDIS_ENABLED=true only
# once you actually have Redis running (e.g. `docker compose up redis`);
# leaving it false avoids any connection attempts entirely.
REDIS_ENABLED=false
REDIS_PASSWORD=renthub_redis_secret
REDIS_PORT=6379
REDIS_URL=redis://:renthub_redis_secret@localhost:6379

# ─── Better Auth ────────────────────────────────────────────────
BETTER_AUTH_SECRET=change_me_to_a_long_random_string_at_least_32_chars
BETTER_AUTH_URL=http://localhost:5000

# ─── Server ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ─── Cloudinary (Image Storage) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (SMTP) ───────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
SMTP_FROM="RentHub <noreply@renthub.app>"

# ─── Payment (Simulated / Plug-in real gateway here) ───────────
PAYMENT_SECRET=change_me_payment_secret
PAYMENT_WEBHOOK_SECRET=change_me_webhook_secret

# ─── Adminer ────────────────────────────────────────────────────
ADMINER_PORT=8080

# ─── Booking Locks ──────────────────────────────────────────────
BOOKING_LOCK_TTL_SECONDS=60

# ─── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
